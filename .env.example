# .env.example — Copy to .env and fill in your values.

# ==========================================
# DATABASE
# ==========================================
# IMPORTANT: sslmode=require (or verify-full) is strongly recommended in
# production. sslmode=disable is ONLY acceptable for loopback local dev
# with a private database — it transmits credentials in cleartext.
# whatsmeow session database
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/whatsmeow?sslmode=require
# Application database
APP_DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/charon?sslmode=require

# ==========================================
# SESSION
# ==========================================
# Session expiry duration (default: 168h = 7 days, sliding window)
SESSION_EXPIRY=168h
# Set to false for local development without HTTPS
COOKIE_SECURE=true

# ==========================================
# SERVER
# ==========================================
PORT=2121
BASEURL=127.0.0.1
CORS_ALLOW_ORIGINS=http://localhost:8080,http://localhost:3000
# Set to true if running behind a reverse proxy (enables X-Real-IP extraction)
BEHIND_PROXY=false

# ==========================================
# PHONE NUMBER
# ==========================================
# Default region for numbers typed without a country code, as an ISO 3166-1
# alpha-2 code. e.g. TR = Turkey, ID = Indonesia, US = United States.
# Leave empty to require every number in full international format with a "+".
# Numbers are validated per country with Google libphonenumber, so any country
# works; this only decides how a national-format number is read.
# Set it on the worker service too: the worker normalises destinations itself.
PHONE_DEFAULT_REGION=TR

# DEPRECATED: the calling code of the default region (digits only, no +).
# Read only when PHONE_DEFAULT_REGION is empty, and mapped to a region with a
# deprecation warning at startup. Use PHONE_DEFAULT_REGION instead.
# PHONE_COUNTRY_CODE=90

# ==========================================
# FEATURES
# ==========================================
CHARON_ENABLE_WEBSOCKET_INCOMING_MSG=false
CHARON_ENABLE_WEBHOOK=false
# If true, skips the IsOnWhatsApp registration check before sending.
SKIP_WHATSAPP_REGISTRATION_CHECK=false
# DEPRECATED: read as an alias of SKIP_WHATSAPP_REGISTRATION_CHECK.
# ALLOW_9_DIGIT_PHONE_NUMBER=false
CHARON_TYPING_DELAY_MIN=1
CHARON_TYPING_DELAY_MAX=3

# ==========================================
# RESOURCE LIMITS
# ==========================================
# Maximum WhatsApp instances per non-admin user
MAX_INSTANCES_PER_USER=10
# Maximum outbox messages per user per day
OUTBOX_MAX_DAILY_PER_USER=10000

# ==========================================
# RATE LIMITING
# ==========================================
RATE_LIMIT_PER_SECOND=10
RATE_LIMIT_BURST=10
RATE_LIMIT_WINDOW_MINUTES=3

# ==========================================
# FILE UPLOAD LIMITS (in MB)
# ==========================================
MAX_FILE_SIZE_IMAGE_MB=5
MAX_FILE_SIZE_VIDEO_MB=16
MAX_FILE_SIZE_AUDIO_MB=16
MAX_FILE_SIZE_DOCUMENT_MB=100

# ==========================================
# AVATAR UPLOAD CONFIGURATION
# ==========================================
UPLOAD_DIR=./uploads
MAX_AVATAR_SIZE_MB=1
ALLOWED_AVATAR_TYPES=jpg,jpeg,png,webp,ico

# ==========================================
# WARMING SYSTEM
# ==========================================
# BOT_VS_BOT warming worker
WARMING_WORKER_ENABLED=false
WARMING_WORKER_INTERVAL_SECONDS=5

# HUMAN_VS_BOT auto-reply
WARMING_AUTO_REPLY_ENABLED=false
# Minimum seconds between auto-replies per room (prevents spam)
WARMING_AUTO_REPLY_COOLDOWN=60

# ==========================================
# AI CONFIGURATION (Google Gemini)
# ==========================================
AI_ENABLED=false
# Supported provider: gemini
AI_DEFAULT_PROVIDER=gemini
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_DEFAULT_MODEL=gemini-flash-latest
# Number of previous messages to include as context
AI_CONVERSATION_HISTORY_LIMIT=10
AI_DEFAULT_TEMPERATURE=0.7
AI_DEFAULT_MAX_TOKENS=150

# ==========================================
# STANDALONE OUTBOX WORKER
# ==========================================
# Database URL where the outbox table resides.
# If left empty, APP_DATABASE_URL is used automatically.
OUTBOX_DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/charon?sslmode=require
# Base URL of the Charon API the worker should connect to
OUTBOX_API_BASEURL=http://localhost:2121
# API key for worker -> API auth. Create one via the web UI (Profile -> API Keys)
# with an admin account. Format: hwa_<32 hex chars>
WORKER_API_KEY=hwa_YOUR_WORKER_API_KEY_HERE
